# Copy to apps/api/.env (or the repo root .env) and adjust as needed.

# HTTP server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (matches infrastructure/docker/docker-compose.yml)
DATABASE_URL=postgresql://sigma:sigma@localhost:5432/sigma?schema=public

# Redis (matches infrastructure/docker/docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Object storage: MinIO from docker compose (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sigma-assets
S3_ACCESS_KEY=sigma
S3_SECRET_KEY=sigmasecret

# Session signing secret: generate a long random value for anything but local dev
SESSION_SECRET=dev-only-change-me-to-a-long-random-string
