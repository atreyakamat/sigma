# Copy to .env.docker and change every secret before exposing SIGMA beyond localhost.
WEB_PORT=3387
PUBLIC_URL=http://localhost:3387
POSTGRES_DB=sigma
POSTGRES_USER=sigma
POSTGRES_PASSWORD=sigma
SESSION_SECRET=change-me-to-a-long-random-string
# Set to true when served over HTTPS (behind a TLS reverse proxy).
COOKIE_SECURE=false
# HTTPS profile (`docker compose --profile https up`): public DNS name Caddy should obtain a certificate for.
# Also set PUBLIC_URL=https://<that host> and COOKIE_SECURE=true.
PUBLIC_HOST=localhost
# Uploads: maximum file size and how quickly realtime edits are folded into the database.
MAX_UPLOAD_MB=20
COLLAB_PERSIST_DEBOUNCE_MS=1000
# First admin account. Leave the password empty to have one generated and printed in `docker compose logs api`.
BOOTSTRAP_ADMIN_EMAIL=admin@sigma.local
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=
# Published images (skip building): registry namespace and version tag, e.g. SIGMA_VERSION=0.1.0.
SIGMA_IMAGE_NAMESPACE=ghcr.io/atreyakamat
SIGMA_VERSION=local
